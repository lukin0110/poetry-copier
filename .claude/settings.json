{
  "permissions": {
    "allow": [
      "WebSearch",
      "Bash(uv:*)",
      "Bash(uvx:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(.claude/hooks/scaffold-check.sh:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/test-template.sh",
            "timeout": 300,
            "statusMessage": "Running template tests..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/scaffold-check.sh",
            "timeout": 900,
            "statusMessage": "Scaffolding and checking generated project..."
          }
        ]
      }
    ]
  }
}
