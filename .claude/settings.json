{
  "permissions": {
    "allow": [
      "WebSearch",
      "Bash"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/test-template.sh",
            "timeout": 300,
            "statusMessage": "Running template tests..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/scaffold-check.sh",
            "timeout": 900,
            "statusMessage": "Scaffolding and checking generated project..."
          }
        ]
      }
    ]
  }
}
