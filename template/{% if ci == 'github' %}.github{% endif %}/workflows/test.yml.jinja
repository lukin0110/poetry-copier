# By default, GitHub Actions don't have permission to write to the ghcr.io registry.
# - Go to: Settings (of this repository) -> Actions -> General -> Workflow permissions
# - Enable: Read and write permissions
name: Lint and Test

on:
  push:
    branches:
      - main
      - master
  pull_request:

concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.head_ref || github.ref_name }}{% endraw %}
  cancel-in-progress: true

jobs:
  test:
    runs-on: ubuntu-latest
    permissions: write-all
    strategy:
      matrix:
        python-version: [ "3.14.3" ]
    name: Python {% raw %}${{ matrix.python-version }}{% endraw %}
    env:
      BRANCH: {% raw %}${{ github.head_ref || github.ref_name }}{% endraw %}
    steps:
      # https://github.com/actions/checkout
      - name: Checkout
        uses: actions/checkout@v6

      # Add an empty .env file.
      # The devcontainers/ci build action fails when the docker-compose.yml file references an .env file that does not exist.
      - name: Touch .env
        run: touch .env

      - name: Set Docker tag
        run: echo "DOCKER_TAG=devcontainer-{% raw %}${{ matrix.python-version }}{% endraw %}-${BRANCH//\//-}" >> $GITHUB_ENV

      # https://github.com/docker/login-action
      - name: Log in to registry
        uses: docker/login-action@v4
        with:
          registry: ghcr.io
          username: {% raw %}${{ github.actor }}{% endraw %}
          password: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}

      # https://github.com/devcontainers/ci
      - name: Build DevContainer
        uses: devcontainers/ci@v0.3
        env:
          PYTHON_VERSION: {% raw %}${{ matrix.python-version }}{% endraw %}
        with:
          imageName: {% raw %}ghcr.io/${{ github.repository }}{% endraw %}
          cacheFrom: {% raw %}ghcr.io/${{ github.repository }}:${{ env.DOCKER_TAG }}{% endraw %}
          imageTag: {% raw %}${{ env.DOCKER_TAG }}{% endraw %}
          push: always

      - name: Run lint
        uses: devcontainers/ci@v0.3
        with:
          cacheFrom: {% raw %}ghcr.io/${{ github.repository }}:${{ env.DOCKER_TAG }}{% endraw %}
          push: never
          runCmd: poe lint

      - name: Run test
        uses: devcontainers/ci@v0.3
        with:
          cacheFrom: {% raw %}ghcr.io/${{ github.repository }}:${{ env.DOCKER_TAG }}{% endraw %}
          push: never
          runCmd: poe test

      # https://github.com/codecov/codecov-action
      - name: Upload coverage
        uses: codecov/codecov-action@v6
        with:
          files: reports/coverage.xml
        env:
          token: {% raw %}${{ secrets.CODECOV_TOKEN }}{% endraw %}
          fail_ci_if_error: false
          verbose: true
