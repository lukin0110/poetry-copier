services:
  # Container definition for the devcontainer
  devcontainer:
    build:
      context: .
      args:
        PYTHON_VERSION: ${PYTHON_VERSION:-{{ python_version }}}
      target: dev
    stdin_open: true
    tty: true
    # Load an optional .env file (the path/required syntax needs Docker Compose v2.24+)
    env_file:
      - path: .env
        required: false
    volumes:
      - .:/workspaces/{{ package_slug }}/
{% if use_app %}
  # Container definition for running the production app image
  app:
    build:
      context: .
      target: app
    tty: true
    # Load an optional .env file (the path/required syntax needs Docker Compose v2.24+)
    env_file:
      - path: .env
        required: false
    ports:
      - "8001:8000"
    volumes:
      - .:/workspaces/{{ package_slug }}/
    command: ["serve", "--dev"]
{% endif %}
volumes:
  claude-code-config:

networks:
  default:
    name: {{ package_slug }}-network
